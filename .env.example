# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Database
POSTGRES_URL=postgresql+psycopg://ehr_app:CHANGE_ME@localhost:5432/ehr_db

# JWT authentication
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=secure-ehr
JWT_AUDIENCE=secure-ehr-api

# LLM
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Embedding
EMBEDDING_MODEL=NeuML/bioclinical-modernbert-base-embeddings

# API security
CORS_ORIGINS=http://localhost:8501
ALLOWED_HOSTS=localhost,127.0.0.1

# Database query timeout
DB_STATEMENT_TIMEOUT_MS=5000